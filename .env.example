# token que o Atalho do iOS envia no header Authorization
# gere com: openssl rand -hex 32
AUDIO_WEBHOOK_SECRET=

# transcrição e extração das notas
OPENAI_API_KEY=

# integração interna do Notion (notion.so/my-integrations)
NOTION_TOKEN=
# id do database, não o da página que o contém
NOTION_DATABASE_ID=

PORT=3333
